Cell[CellGroupData[{

Cell["2. Import and validate the 17 data files", "Section",ExpressionUUID->"0d564771-cbb4-49c1-bfa3-4c8867ea8497"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "paper5Read", ",", " ", "paper5Load", ",", " ", "paper5Parity", ",", " ",
       "paper5Probability", ",", "\n", "  ", "paper5Correlations", ",", " ", 
      "paper5Witness", ",", " ", "paper5Inspect"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5Read", "[", 
      RowBox[{"time_Integer", ",", " ", 
       RowBox[{"rep_Integer", " ", "/;", " ", 
        RowBox[{"1", " ", "<=", " ", "rep", " ", "<=", " ", "10"}]}]}], "]"}],
      " ", ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"folder", ",", " ", "files", ",", " ", "raw"}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{
        RowBox[{"folder", " ", "=", " ", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"paper5Root", ",", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"rep", "-", "1"}], "]"}], ",", "\n", "     ", 
            RowBox[{"\"\<5Q_GHZ_\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "time", "]"}], " ", "<>", " ", 
             "\"\<ns\>\""}], ",", " ", "\"\<readout_cali\>\""}], "}"}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"files", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"folder", ",", "\n", "     ", 
              RowBox[{"\"\<basis_measurement\>\"", " ", "<>", " ", 
               RowBox[{"ToString", "[", "k", "]"}], " ", "<>", " ", 
               "\"\<.txt\>\""}]}], "}"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "16"}], "}"}]}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"files", ",", " ", "FileExistsQ"}], "]"}]}], ",", "\n", 
          "   ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<MissingFiles\>\"", ",", " ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<TimeNS\>\"", "->", "time"}], ",", "\n", "      ", 
               RowBox[{"\"\<Repetition\>\"", "->", "rep"}], ",", " ", 
               RowBox[{"\"\<Paths\>\"", "->", 
                RowBox[{"Select", "[", 
                 RowBox[{"files", ",", " ", 
                  RowBox[{
                   RowBox[{"!", 
                    RowBox[{"FileExistsQ", "[", "#", "]"}]}], "&"}]}], 
                 "]"}]}]}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"raw", " ", "=", " ", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", "\n", "     ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Import", "[", 
               RowBox[{"#", ",", " ", "\"\<Table\>\"", ",", " ", 
                RowBox[{"\"\<FieldSeparators\>\"", "->", "\"\< \>\""}]}], 
               "]"}], "&"}], " ", "/@", " ", "files"}], ",", " ", "$Failed"}],
            "]"}]}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"raw", " ", "===", " ", "$Failed"}], " ", "||", " ", 
           RowBox[{"!", 
            RowBox[{"ListQ", "[", "raw", "]"}]}], " ", "||", "\n", "    ", 
           RowBox[{"!", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"raw", ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"MatrixQ", "[", 
                 RowBox[{"#", ",", " ", "NumericQ"}], "]"}], " ", "&&", " ", 
                RowBox[{
                 RowBox[{"Length", "[", "#", "]"}], " ", ">=", " ", "32"}], 
                " ", "&&", "\n", "       ", 
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"First", "[", "#", "]"}], "]"}], " ", ">=", " ", 
                 "1"}]}], " ", "&"}]}], "]"}]}]}], ",", "\n", "   ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidData\>\"", ",", " ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<TimeNS\>\"", "->", "time"}], ",", "\n", "     ", 
               RowBox[{"\"\<Repetition\>\"", "->", "rep"}]}], "|>"}]}], "]"}],
            "]"}]}], "]"}], ";", "\n", "  ", "raw"}]}], "\n", "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5Load", "[", 
      RowBox[{"time_Integer", ",", " ", "rep_Integer"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"paper5Read", "[", 
      RowBox[{"time", ",", "rep"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5Parity", "[", 
      RowBox[{"row_", "?", "MatrixQ"}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"DigitCount", "[", 
          RowBox[{"x", ",", "2", ",", "1"}], "]"}]}], " ", 
        RowBox[{"row", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"x", "+", "1"}], ",", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "31"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5Probability", "[", "data_List", "]"}], " ", ":=", "\n", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"v", ",", " ", "norm"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"v", " ", "=", " ", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"paper5Rows", "[", "\"\<AllZ\>\"", "]"}], ",", " ", 
            RowBox[{"1", ";;", "32"}], ",", " ", "1"}], "]"}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"norm", " ", "=", " ", 
         RowBox[{"Total", "[", "v", "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"VectorQ", "[", 
             RowBox[{"v", ",", " ", "NumericQ"}], "]"}]}], " ", "||", " ", 
           RowBox[{"!", 
            RowBox[{"NumericQ", "[", "norm", "]"}]}], " ", "||", " ", 
           RowBox[{"norm", " ", "<=", " ", "0"}]}], ",", "\n", "    ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidZPopulation\>\"", ",", " ", 
             RowBox[{"<|", "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"N", "[", 
         RowBox[{"v", "/", "norm"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5Correlations", "[", "data_List", "]"}], " ", ":=", " ", 
     RowBox[{"paper5Parity", " ", "/@", " ", "data"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"IMPORTANT", ":", " ", 
     RowBox[{
      RowBox[{
      "this", " ", "is", " ", "a", " ", "candidate", " ", "witness", " ", 
       "obtained", " ", "by", " ", "summing", " ", "all", "\n", "   ", "10", 
       " ", "two"}], "-", 
      RowBox[{"Y", " ", "full"}], "-", 
      RowBox[{
      "parity", " ", "correlators", " ", "with", " ", "a", " ", "plus", " ", 
       RowBox[{"sign", ".", " ", "Confirm"}], " ", "the", "\n", "   ", 
       "experimental", " ", "normalization", " ", "and", " ", "any", " ", 
       "basis"}], "-", 
      RowBox[{
      "dependent", " ", "sign", " ", "convention", "\n", "   ", "against", 
       " ", "the", " ", "paper", " ", "and", " ", "original", " ", 
       RowBox[{"notebook", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5Witness", "[", "data_List", "]"}], " ", ":=", "\n", "  ", 
     RowBox[{"Abs", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"paper5Correlations", "[", "data", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"paper5Rows", "[", "\"\<TwoY\>\"", "]"}], "]"}], "]"}], 
       "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5Inspect", "[", 
      RowBox[{"time_Integer", ",", " ", "rep_Integer"}], "]"}], " ", ":=", 
     "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", "=", 
         RowBox[{"paper5Read", "[", 
          RowBox[{"time", ",", "rep"}], "]"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FailureQ", "[", "data", "]"}], ",", " ", 
          RowBox[{"Return", "[", "data", "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<TimeNS\>\"", "->", "time"}], ",", " ", 
          RowBox[{"\"\<Repetition\>\"", "->", "rep"}], ",", "\n", "    ", 
          RowBox[{"\"\<Dimensions\>\"", "->", 
           RowBox[{"Dimensions", "[", "data", "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<BasisSettings\>\"", "->", "paper5BasisLabels"}], ",", 
          "\n", "    ", 
          RowBox[{"\"\<Correlations\>\"", "->", 
           RowBox[{"paper5Correlations", "[", "data", "]"}]}], ",", "\n", 
          "    ", 
          RowBox[{"\"\<AllZSum\>\"", "->", 
           RowBox[{"Total", "[", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{"12", ",", 
               RowBox[{"1", ";;", "32"}], ",", "1"}], "]"}], "]"}], "]"}]}], 
          ",", "\n", "    ", 
          RowBox[{"\"\<CandidateWitness\>\"", "->", 
           RowBox[{"paper5Witness", "[", "data", "]"}]}]}], "|>"}]}]}], "\n", 
      " ", "]"}]}], ";"}], "\n", "\n", "\n"}]}]], "Input",
