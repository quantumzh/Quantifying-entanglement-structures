Cell[CellGroupData[{
Cell["5-Qubit | Complete S36 Definitions and S10 Integration", "Title",ExpressionUUID->"47a2b643-6d65-4c1b-9587-808d49371e52"],

Cell["\<\
Merged notebook. S36 uses the same list-of-associations, additionUnion / \
maximumUnion conventions as the 7-qubit validation code. Experimental files \
are read locally. Review paper conventions and witness normalization before \
publication.\
\>", "Text",ExpressionUUID->"81c24c92-f8f8-4c17-9ebd-5444d2002585"],

Cell[CellGroupData[{

Cell["1. Settings and measurement layout", "Section",ExpressionUUID->"e985a3c3-d9f9-4aec-b2bc-4f82641e3c54"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`paper5*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"paper5N", " ", "=", " ", "5"}], ";", " ", 
    RowBox[{"paper5J", " ", "=", " ", "2"}], ";", " ", 
    RowBox[{"paper5H", " ", "=", " ", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"paper5Times", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "0", ",", " ", "500", ",", " ", "1000", ",", " ", "1500", ",", " ", 
       "3000", ",", " ", "6000", ",", " ", "10000", ",", " ", "20000"}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "paper5Root", " ", "=", " ", 
     "\"\<E:\\\\Detection of k partite \
entanglement\\\\Experimental_special_bases\\\\5QGHZ_special_bases\\\\5Q\>\""}]\
, ";"}], "\n", 
   RowBox[{
    RowBox[{"paper5Rows", " ", "=", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<TwoY\>\"", " ", "->", " ", 
        RowBox[{"Range", "[", "10", "]"}]}], ",", " ", 
       RowBox[{"\"\<AllX\>\"", " ", "->", " ", "11"}], ",", "\n", "  ", 
       RowBox[{"\"\<AllZ\>\"", " ", "->", " ", "12"}], ",", " ", 
       RowBox[{"\"\<FourY\>\"", " ", "->", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"13", ",", "17"}], "]"}]}]}], "|>"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"paper5F2", " ", "=", " ", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"paper5BasisLabels", " ", "=", " ", 
     RowBox[{"Join", "[", "\n", " ", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1", ",", "2", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "2", ",", "1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "2", ",", "2", ",", "1"}], "}"}], ",", 
         "\n", "   ", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "1", ",", "1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "1", ",", "2", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "2", ",", "1", ",", "1"}], "}"}], ",", 
         "\n", "   ", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1", ",", "1", ",", "1", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1", ",", "1", ",", "2", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1", ",", "2", ",", "1", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2", ",", "1", ",", "1", ",", "1"}], "}"}]}], " ",
         "}"}], ",", "\n", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], "}"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3", ",", "3", ",", "3", ",", "3"}], "}"}], "}"}], 
       ",", "\n", " ", 
