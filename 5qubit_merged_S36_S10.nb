Cell[CellGroupData[{

Cell["3. Partition construction and S10 sums", "Section",ExpressionUUID->"dffce677-9f56-4c7f-9251-aa2af44f3902"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "paper5Canonical", ",", " ", "paper5Partitions", ",", " ", "paper5DStar",
       ",", "\n", " ", "paper5BlockTerm", ",", " ", "paper5PartitionSum", ",",
       " ", "paper5CheckPartitions"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Generate", " ", "every", " ", "unordered", " ", "set", " ", 
      "partition"}], ",", " ", 
     RowBox[{"once", ";", " ", 
      RowBox[{
       RowBox[{"no", " ", "permutations", " ", "of", "\n", "   ", 
        RowBox[{"blocks", ".", " ", "A"}], " ", "depth", " ", "family", " ", 
        "comprises", " ", "partitions", " ", "with", " ", "largest", " ", 
        "block"}], " ", "<=", " ", 
       RowBox[{"d", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5Partitions", "[", 
      RowBox[{"{", "}"}], "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{"{", "}"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"paper5Partitions", "[", "list_List", "]"}], " ", "/;", " ", 
      RowBox[{
       RowBox[{"Length", "[", "list", "]"}], " ", ">", " ", "0"}]}], " ", ":=",
      "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"First", "[", "list", "]"}]}], ",", " ", 
         RowBox[{"sub", "=", 
          RowBox[{"paper5Partitions", "[", 
           RowBox[{"Rest", "[", "list", "]"}], "]"}]}]}], "}"}], ",", "\n", 
       "  ", 
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Join", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Prepend", "[", 
              RowBox[{"#", ",", " ", 
               RowBox[{"{", "x", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
            "sub"}], ")"}], ",", "\n", "    ", 
          RowBox[{"Flatten", "[", "\n", "     ", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"ReplacePart", "[", 
               RowBox[{"part", ",", " ", 
                RowBox[{"k", " ", "->", " ", 
                 RowBox[{"Append", "[", 
                  RowBox[{
                   RowBox[{"part", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", " ", "x"}], 
                  "]"}]}]}], "]"}], ",", "\n", "      ", 
              RowBox[{"{", 
               RowBox[{"part", ",", "sub"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"Length", "[", "part", "]"}]}], "}"}]}], "]"}], ",", 
            "1"}], "]"}]}], "\n", "  ", "]"}]}]}], "\n", " ", "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5Canonical", "[", "part_List", "]"}], " ", ":=", " ", 
     RowBox[{"Sort", "[", 
      RowBox[{"Sort", " ", "/@", " ", "part"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5DStar", "[", 
      RowBox[{"d_Integer", " ", "/;", " ", 
       RowBox[{"1", " ", "<=", " ", "d", " ", "<=", " ", "4"}]}], "]"}], " ", 
     ":=", "\n", " ", 
     RowBox[{"DeleteDuplicates", "[", "\n", "  ", 
      RowBox[{"paper5Canonical", " ", "/@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"paper5Partitions", "[", 
          RowBox[{"Range", "[", "5", "]"}], "]"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Length", " ", "/@", " ", "#"}], "]"}], " ", "<=", " ", 
           "d"}], " ", "&"}]}], "]"}]}], "\n", " ", "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Original", " ", "data", " ", 
       RowBox[{"indexing", ":", " ", "x"}]}], " ", "=", " ", 
      RowBox[{"b1", " ", "+", " ", 
       RowBox[{"2", " ", "b2"}], " ", "+", " ", 
       RowBox[{"4", " ", "b3"}], " ", "+", " ", 
       RowBox[{"8", " ", "b4"}], " ", "+", " ", 
       RowBox[{"16", " ", 
        RowBox[{"b5", ".", "\n", "   ", "Mathematica"}], " ", "FromDigits", 
        " ", "reverses", " ", "this", " ", "weighting"}]}]}], ",", " ", 
     RowBox[{"so", " ", "use", " ", "explicit", " ", 
      RowBox[{"sum", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"paper5BlockTerm", "[", 
      RowBox[{"A_List", ",", " ", "p_List"}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"index", " ", "=", " ", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"#", "-", "1"}], ")"}]}], "&"}], " ", "/@", " ", "A"}],
            "]"}]}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"p", "[", 
          RowBox[{"[", "index", "]"}], "]"}], " ", 
         RowBox[{"p", "[", 
          RowBox[{"[", 
