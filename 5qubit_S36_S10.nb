            RowBox[{"v", "=", 
             RowBox[{"s36SupplementSetGHZ5", "[", 
              RowBox[{"d", ",", "1"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<d\>\"", "->", "d"}], ",", 
            RowBox[{"\"\<h\>\"", "->", "1"}], ",", 
            RowBox[{"\"\<Cdh\>\"", "->", 
             RowBox[{"s36CoefficientGHZ5", "[", 
