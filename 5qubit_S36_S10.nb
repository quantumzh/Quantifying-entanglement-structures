   "\n", "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Verify", " ", "the", " ", "coefficients", " ", "and", " ", "exchanges", 
     " ", "before", " ", "interpreting", " ", 
     RowBox[{"data", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"s36DiagnosticsGHZ5", "[", "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Dataset", "[", 
