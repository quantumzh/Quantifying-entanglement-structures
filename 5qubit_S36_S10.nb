     "\:9ed8\:8ba4\:8ba1\:7b97\:5168\:90e8\:6df1\:5ea6"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"tenRepeatsGHZ5", "[", "time_Integer", "]"}], ":=", 
      RowBox[{"Dataset", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"caseGHZ5", "[", 
            RowBox[{"time", ",", "r", ",", "d"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", "1", ",", "4"}], "}"}], ",", 
           RowBox[{"{", 
