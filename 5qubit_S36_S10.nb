Cell[CellGroupData[{

Cell["6. Added k-separability: 3-separable and 4-separable", "Section",ExpressionUUID->"7ee9e76b-b8f7-49ce-b355-89984aa29c0e"],

Cell["\<\
Uses the existing five-qubit Pauli witness, experimental data loader, \
UpsilonGamma exchange construction, weighted union, and ED function. For k=3 \
or 4, the partition set is all partitions into exactly k blocks. Compare LEFT \
and RIGHT for h=1 or 2. \
\>", "Text",
 CellChangeTimes->{{4.001299490202776*^9, 
  4.001299498115758*^9}},ExpressionUUID->"6f0c9c8b-4160-4b69-94d9-\
44151f43c85d"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "sStarGHZ5", ",", " ", "upsilonKSGHZ5", ",", " ", 
      "referenceUpsilonKSGHZ5", ",", "\n", " ", "ksComplementGHZ5", ",", " ", 
      "ksCoefficientGHZ5", ",", " ", "ksCaseGHZ5", ",", "\n", " ", 
      "ksTenRepeatsGHZ5", ",", " ", "ksAllTimesGHZ5"}], "]"}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"S_k", "^"}], "*"}], ":", " ", 
     RowBox[{
      RowBox[{"all", " ", "k"}], "-", 
      RowBox[{
      "block", " ", "partitions", " ", "of", " ", "the", " ", "five", " ", 
       RowBox[{"qubits", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sStarGHZ5", "[", 
      RowBox[{"k_Integer", " ", "/;", " ", 
       RowBox[{"2", " ", "<=", " ", "k", " ", "<=", " ", "5"}]}], "]"}], " ", 
     ":=", "\n", " ", 
     RowBox[{
      RowBox[{"sStarGHZ5", "[", "k", "]"}], " ", "=", " ", 
      RowBox[{"Select", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"canonicalPartitionGHZ5", " ", "/@", " ", 
         RowBox[{"partitionsGHZ5", "[", 
