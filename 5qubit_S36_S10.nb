        "]"}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"summaryGHZ5", "[", "results_List", "]"}], " ", ":=", "\n", " ", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"failed", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"results", ",", "FailureQ"}], "]"}]}], ",", "groups"}], 
        "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"failed", " ", "=!=", " ", 
           RowBox[{"{", "}"}]}], ",", "\n", "    ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<ResultsIncomplete\>\"", ",", "\n", "      ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<FailureCount\>\"", "->", 
                RowBox[{"Length", "[", "failed", "]"}]}], ",", "\n", 
               "       ", 
               RowBox[{"\"\<FirstFailure\>\"", "->", 
                RowBox[{"First", "[", "failed", "]"}]}]}], "|>"}]}], "]"}], 
           "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"groups", "=", 
         RowBox[{"GroupBy", "[", 
          RowBox[{"results", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", "\"\<TimeNS\>\"", "]"}], ",", 
              RowBox[{"#", "[", "\"\<DepthBound\>\"", "]"}]}], "}"}], "&"}]}],
           "]"}]}], ";", "\n", "  ", 
        RowBox[{"Dataset", "[", 
         RowBox[{"KeyValueMap", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"key", ",", "rows"}], "}"}], ",", "\n", "     ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<TimeNS\>\"", "->", 
