Cell["5. Unified Eq. S36 / Eq. S10 evaluator", "Section",ExpressionUUID->"0eb6b9b2-bf8a-446d-8711-e312eeb1b43f"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "caseGHZ5", ",", " ", "tenRepeatsGHZ5", ",", " ", "summaryGHZ5", ",", 
      " ", "diagnoseGHZ5"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"caseGHZ5", "[", 
      RowBox[{"time_Integer", ",", " ", 
       RowBox[{"r_Integer", " ", "/;", " ", 
        RowBox[{"1", " ", "<=", " ", "r", " ", "<=", " ", "10"}]}], ",", "\n",
        "    ", 
       RowBox[{"d_Integer", " ", "/;", " ", 
        RowBox[{"1", " ", "<=", " ", "d", " ", "<=", " ", "4"}]}]}], "]"}], 
     " ", ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "data", ",", "p", ",", "w", ",", "s", ",", "C", ",", "mainSet", ",", 
         "supSet", ",", "main", ",", "extra", ",", "den", ",", "\n", 
         "         ", "left", ",", "right", ",", "delta", ",", "parts", ",", 
         "rest", ",", "eqn"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"data", " ", "=", " ", 
         RowBox[{"loadGHZ5", "[", 
          RowBox[{"time", ",", "r"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FailureQ", "[", "data", "]"}], ",", 
          RowBox[{"Return", "[", "data", "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"probabilitiesGHZ5", "[", "data", "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FailureQ", "[", "p", "]"}], ",", 
          RowBox[{"Return", "[", "p", "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"w", " ", "=", " ", 
         RowBox[{"witnessGHZ5", "[", "data", "]"}]}], ";", "\n", "  ", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "*", 
           RowBox[{"p", "[", 
            RowBox[{"[", "32", "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"d", " ", "<=", " ", "2"}], ",", "\n", "   ", 
          RowBox[{
           RowBox[{"eqn", " ", "=", " ", "\"\<S36\>\""}], ";", "\n", "   ", 
           RowBox[{"C", " ", "=", " ", 
            RowBox[{"s36CoefficientGHZ5", "[", 
             RowBox[{"d", ",", " ", "h"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"mainSet", " ", "=", " ", 
            RowBox[{"s36MainSetGHZ5", "[", 
             RowBox[{"d", ",", " ", "h"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"supSet", " ", "=", " ", 
            RowBox[{"s36SupplementSetGHZ5", "[", 
             RowBox[{"d", ",", " ", "h"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"!", 
               RowBox[{"NumericQ", "[", "C", "]"}]}], " ", "||", " ", 
              RowBox[{"!", 
               RowBox[{"ListQ", "[", "mainSet", "]"}]}], " ", "||", "\n", 
              "       ", 
              RowBox[{"!", 
               RowBox[{"ListQ", "[", "supSet", "]"}]}]}], ",", "\n", "     ", 
             
             RowBox[{"Return", "[", 
              RowBox[{"Failure", "[", 
               RowBox[{
               "\"\<S36DefinitionsMissing\>\"", ",", "\n", "       ", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<DepthBound\>\"", "->", "d"}], ",", " ", 
                  RowBox[{"\"\<Cdh\>\"", "->", "C"}], ",", "\n", "        ", 
                  RowBox[{"\"\<MainSetReady\>\"", "->", 
                   RowBox[{"ListQ", "[", "mainSet", "]"}]}], ",", "\n", 
                  "        ", 
                  RowBox[{"\"\<SupplementarySetReady\>\"", "->", 
                   RowBox[{"ListQ", "[", "supSet", "]"}]}]}], "|>"}]}], "]"}],
               "]"}]}], "]"}], ";", "\n", "   ", 
           RowBox[{"main", " ", "=", " ", 
            RowBox[{"epsUpsilonGHZ5", "[", 
             RowBox[{"mainSet", ",", "p"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"extra", " ", "=", " ", 
            RowBox[{"epsUpsilonGHZ5", "[", 
             RowBox[{"supSet", ",", "p"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"FailureQ", "[", "main", "]"}], " ", "||", " ", 
              RowBox[{"FailureQ", "[", "extra", "]"}]}], ",", "\n", "     ", 
             RowBox[{"Return", "[", 
              RowBox[{"Failure", "[", 
               RowBox[{
               "\"\<ExchangeSetEvaluation\>\"", ",", "\n", "       ", 
                RowBox[{"<|", 
                 RowBox[{"\"\<DepthBound\>\"", "->", "d"}], "|>"}]}], "]"}], 
              "]"}]}], "]"}], ";", "\n", "   ", 
           RowBox[{"den", " ", "=", " ", 
            RowBox[{
             RowBox[{"Binomial", "[", 
              RowBox[{"5", ",", "2"}], "]"}], " ", "+", " ", 
             RowBox[{"f2GHZ5", " ", 
              RowBox[{"(", 
               RowBox[{"C", "-", "1"}], ")"}]}]}]}], ";", "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"!", 
               RowBox[{"NumericQ", "[", "den", "]"}]}], " ", "||", " ", 
              RowBox[{"den", " ", "==", " ", "0"}]}], ",", "\n", "     ", 
             RowBox[{"Return", "[", 
              RowBox[{"Failure", "[", 
               RowBox[{"\"\<InvalidDenominator\>\"", ",", 
                RowBox[{"<|", 
                 RowBox[{"\"\<DepthBound\>\"", "->", "d"}], "|>"}]}], "]"}], 
              "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"twice", " ", "of", " ", "left"}], "*)"}], "\n", "   ", 
           RowBox[{"left", " ", "=", " ", 
            RowBox[{"C", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"w", "-", 
                RowBox[{"2", " ", "f2GHZ5", " ", "s"}]}], ")"}], "/", 
              RowBox[{"(", "den", ")"}]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"twice", " ", "of", " ", "right"}], "*)"}], "\n", "   ", 
           RowBox[{"right", " ", "=", " ", 
            RowBox[{
             RowBox[{"2", "main"}], " ", "+", 
             RowBox[{"2", "f2GHZ5", " ", "C", " ", 
              RowBox[{"extra", "/", "den"}]}]}]}], ";"}], "\n", "   ", ",", 
          "\n", "   ", 
          RowBox[{
           RowBox[{"eqn", " ", "=", " ", "\"\<S10\>\""}], ";", "\n", "   ", 
           RowBox[{"parts", " ", "=", " ", 
            RowBox[{"minimalPartitionsGHZ5", "[", "d", "]"}]}], ";", "\n", 
           "   ", 
           RowBox[{"rest", " ", "=", " ", 
            RowBox[{"Complement", "[", 
             RowBox[{
              RowBox[{"minimalPartitionsGHZ5", "[", "4", "]"}], ",", 
              "parts"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"main", " ", "=", " ", 
            RowBox[{"partitionSumGHZ5", "[", 
             RowBox[{"parts", ",", "p"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"extra", " ", "=", " ", 
            RowBox[{"partitionSumGHZ5", "[", 
             RowBox[{"rest", ",", "p"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"left", " ", "=", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"w", "-", 
               RowBox[{"2", " ", "f2GHZ5", " ", "s"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"Binomial", "[", 
               RowBox[{"5", ",", "2"}], "]"}], ")"}]}]}], ";", 
           RowBox[{"right", " ", "=", " ", 
            RowBox[{"main", " ", "+", 
             RowBox[{"f2GHZ5", " ", 
              RowBox[{"extra", "/", 
               RowBox[{"Binomial", "[", 
                RowBox[{"5", ",", "2"}], "]"}]}]}]}]}], 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"\\", "sqrt"}], 
             RowBox[{"{", 
              RowBox[{"\\r", "ho_", 
               RowBox[{"{", "m_A", "}"}], "\\r", "ho_", 
               RowBox[{"{", "n_A", "}"}]}], "}"}], " ", "has", " ", "been", 
             " ", "calculated", " ", "twice", " ", "in", " ", "main"}], 
            "*)"}], ";"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
        RowBox[{"delta", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"left", "-", "right"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<TimeNS\>\"", "->", "time"}], ",", 
          RowBox[{"\"\<Repetition\>\"", "->", "r"}], ",", "\n", "    ", 
          RowBox[{"\"\<DepthBound\>\"", "->", "d"}], ",", 
          RowBox[{"\"\<Equation\>\"", "->", "eqn"}], ",", "\n", "    ", 
          RowBox[{"\"\<w\>\"", "->", "w"}], ",", 
          RowBox[{"\"\<s\>\"", "->", "s"}], ",", 
          RowBox[{"\"\<MainTerm\>\"", "->", "main"}], ",", "\n", "    ", 
          RowBox[{"\"\<SupplementaryTerm\>\"", "->", "extra"}], ",", "\n", 
          "    ", 
          RowBox[{"\"\<LeftSide\>\"", "->", 
           RowBox[{"N", "[", "left", "]"}]}], ",", 
          RowBox[{"\"\<RightSide\>\"", "->", 
           RowBox[{"N", "[", "right", "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<Delta\>\"", "->", "delta"}], ",", 
          RowBox[{"\"\<Violation\>\"", "->", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"delta", ">", "0"}], "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<CertifiedDepthAtLeast\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{"delta", ">", "0"}], "]"}], ",", 
             RowBox[{"d", "+", "1"}], ",", "\n", "       ", 
             RowBox[{"Missing", "[", "\"\<NotCertified\>\"", "]"}]}], 
            "]"}]}]}], "|>"}]}]}], "\n", " ", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "tenRepeatsGHZ5", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
