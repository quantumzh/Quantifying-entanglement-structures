Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "canonicalPartitionGHZ5", ",", " ", "partitionsGHZ5", ",", " ", 
      "minPartitionsGHZ5", ",", "\n", " ", "blockTermGHZ5", ",", " ", 
