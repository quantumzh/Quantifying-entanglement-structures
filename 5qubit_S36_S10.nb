                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<DepthBound\>\"", "->", 
                RowBox[{"key", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "      ", 
               RowBox[{"\"\<Count\>\"", "->", 
                RowBox[{"Length", "[", "rows", "]"}]}], ",", "\n", "      ", 
               RowBox[{"\"\<MeanDelta\>\"", "->", 
                RowBox[{"Mean", "[", 
                 RowBox[{"rows", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "\"\<Delta\>\""}], "]"}], "]"}], 
                 "]"}]}], ",", "\n", "      ", 
               RowBox[{"\"\<StdDelta\>\"", "->", 
