   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Generate", " ", "every", " ", "unordered", " ", "set", " ", 
      "partition"}], ",", " ", 
     RowBox[{"once", ";", " ", 
      RowBox[{
       RowBox[{"no", " ", "permutations", " ", "of", "\n", "   ", 
