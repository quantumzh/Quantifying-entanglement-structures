        "comprises", " ", "partitions", " ", "with", " ", "largest", " ", 
        "block"}], " ", "<=", " ", 
       RowBox[{"d", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"partitionsGHZ5", "[", 
      RowBox[{"{", "}"}], "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{"{", "}"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"partitionsGHZ5", "[", "list_List", "]"}], " ", "/;", " ", 
      RowBox[{
       RowBox[{"Length", "[", "list", "]"}], " ", ">", " ", "0"}]}], " ", ":=",
      "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"First", "[", "list", "]"}]}], ",", " ", 
         RowBox[{"sub", "=", 
          RowBox[{"partitionsGHZ5", "[", 
           RowBox[{"Rest", "[", "list", "]"}], "]"}]}]}], "}"}], ",", "\n", 
       "  ", 
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Join", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Prepend", "[", 
              RowBox[{"#", ",", " ", 
               RowBox[{"{", "x", "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
            "sub"}], ")"}], ",", "\n", "    ", 
          RowBox[{"Flatten", "[", "\n", "     ", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"ReplacePart", "[", 
               RowBox[{"part", ",", " ", 
                RowBox[{"k", " ", "->", " ", 
                 RowBox[{"Append", "[", 
                  RowBox[{
                   RowBox[{"part", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", " ", "x"}], 
                  "]"}]}]}], "]"}], ",", "\n", "      ", 
              RowBox[{"{", 
               RowBox[{"part", ",", "sub"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"Length", "[", "part", "]"}]}], "}"}]}], "]"}], ",", 
            "1"}], "]"}]}], "\n", "  ", "]"}]}]}], "\n", " ", "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"canonicalPartitionGHZ5", "[", "part_List", "]"}], " ", ":=", 
     " ", 
     RowBox[{"Sort", "[", 
      RowBox[{"Sort", " ", "/@", " ", "part"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"minPartitionsGHZ5", "[", 
      RowBox[{"d_Integer", " ", "/;", " ", 
       RowBox[{"1", " ", "<=", " ", "d", " ", "<=", " ", "4"}]}], "]"}], " ", 
     ":=", "\n", " ", 
