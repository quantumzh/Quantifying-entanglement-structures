Cell["\<\
Verification notes: A) The ordering of qubits in the user-provided Pauli code \
is assumed Q1..Q9 from left to right; the measurement outcome index is Q1 \
least significant, matching the user's nested x loop. B) The exact definition \
of D*_d and the normalization of Gamma when identical swapped states occur \
should be checked against an author-verified small-N case before interpreting \
the experimental result as a rigorous witness. C) Ten user paths were all \
rep0; the code uses rep0..rep9 placeholders that must match real folders. D) \
Mathematica has not been executed in this environment.\
\>", "Text",ExpressionUUID->"62f527cd-1d6f-49ac-b7e0-af31872b314e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. S11 high-depth d=5..9: independent Gamma-set bounds", "Section",ExpressionUUID->"195c3e03-a490-4e62-955f-e3c1fa88085c"],

Cell["\<\
Eq. S11 for ellOmega=9, j=4: LEFT = (SumOmega Abs[W4] - 28*SumOmega Sqrt[p_m \
p_n])/252. RIGHT = epsilonGamma1 + (1/9) epsilonGammaHat[d], with \
epsilonGamma1 from Gamma_(1D)^(Omega,1), and GammaHat[d] = \
Gamma_((N-1)D)^(Omega,1) SET DIFFERENCE Gamma_(dD)^(Omega,1). For the four \
complementary state pairs, all 9 qubits differ so the full-system observable \
W4 may be used. Gamma sets are state-weight dictionaries, NOT joint-pair \
Upsilon sets.\
\>", "Text",ExpressionUUID->"27c0774a-4b1c-44bf-b35a-a8591dc9ef7c"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "referenceGamma1", ",", " ", "gammaHatS11", ",", " ", "oneS11", ",", " ",
       "allS11", ",", "\n", "         ", "compareAllDepths", ",", " ", 
      "allRepetitionsBoth"}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Reuse", " ", "gammaD", " ", "and", " ", "associated", " ", "operations", 
     " ", "from", " ", "Section", " ", "4."}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"referenceGamma1", "[", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"referenceGamma1", "[", "]"}], " ", "=", " ", 
      RowBox[{"gammaD", "[", 
       RowBox[{"1", ",", "1"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Paper", ":", " ", 
      RowBox[{"overlined", " ", "Gamma_dD"}]}], " ", "=", " ", 
     RowBox[{"Gamma_", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"N", "-", "1"}], ",", "D"}], ")"}], " ", "\\", " ", 
       RowBox[{"Gamma_dD", ".", "\n", "   ", "The"}]}], " ", "set", " ", 
      "difference", " ", "removes", " ", "keys", " ", "in", " ", "Gamma_dD", 
      " ", 
      RowBox[{"entirely", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gammaHatS11", "[", "d_Integer", "]"}], " ", ":=", "\n", " ", 
     RowBox[{
      RowBox[{"gammaHatS11", "[", "d", "]"}], " ", "=", "\n", "   ", 
      RowBox[{"KeySelect", "[", 
       RowBox[{
        RowBox[{"gammaD", "[", 
         RowBox[{"8", ",", "1"}], "]"}], ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{
            RowBox[{"gammaD", "[", 
             RowBox[{"d", ",", "1"}], "]"}], ",", "#"}], "]"}]}], "&"}]}], 
       "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"oneS11", "[", 
      RowBox[{"d_Integer", ",", "corr_List", ",", "p_List"}], "]"}], " ", ":=",
      "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wv", ",", "L", ",", "e", ",", "eHat", ",", "R"}], "}"}], ",",
        "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"5", "<=", "d", "<=", "9"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Length", "[", "corr", "]"}], ">=", "340"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Length", "[", "p", "]"}], "==", "512"}], "\n", 
             "      ", "&&", 
             RowBox[{"VectorQ", "[", 
              RowBox[{"corr", ",", "NumericQ"}], "]"}], "&&", 
             RowBox[{"VectorQ", "[", 
              RowBox[{"p", ",", "NumericQ"}], "]"}]}], ")"}]}], ",", "\n", 
          "   ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<BadS11Input\>\"", ",", 
             RowBox[{"<|", "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"wv", "=", 
         RowBox[{"allW", "[", 
          RowBox[{"4", ",", "corr"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"L", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"Abs", "[", "wv", "]"}], "]"}], "-", 
             RowBox[{"28", " ", 
              RowBox[{"pairPopulation", "[", "p", "]"}]}]}], ")"}], "/", 
           "252"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"e", "=", 
         RowBox[{"N", "[", 
          RowBox[{"epsGamma", "[", 
           RowBox[{
            RowBox[{"referenceGamma1", "[", "]"}], ",", "p"}], "]"}], "]"}]}],
         ";", "\n", "  ", 
        RowBox[{"eHat", "=", 
         RowBox[{"N", "[", 
          RowBox[{"epsGamma", "[", 
           RowBox[{
            RowBox[{"gammaHatS11", "[", "d", "]"}], ",", "p"}], "]"}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"R", "=", 
         RowBox[{"N", "[", 
          RowBox[{"e", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "9"}], ")"}], "eHat"}]}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<d\>\"", "->", "d"}], ",", 
          RowBox[{"\"\<Equation\>\"", "->", "\"\<S11\>\""}], ",", 
          RowBox[{"\"\<W(1,8)\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"wv", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<W(2,7)\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"wv", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<W(3,6)\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"wv", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<W(4,5)\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"wv", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<LEFT\>\"", "->", "L"}], ",", 
          RowBox[{"\"\<EpsilonGamma1\>\"", "->", "e"}], ",", 
          RowBox[{"\"\<EpsilonGammaHat\>\"", "->", "eHat"}], ",", "\n", "   ", 
          RowBox[{"\"\<RIGHT\>\"", "->", "R"}], ",", 
          RowBox[{"\"\<Delta\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"L", "-", "R"}], "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<ViolationQ\>\"", "->", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"L", ">", "R"}], "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<GammaReferenceKeys\>\"", "->", 
           RowBox[{"Length", "[", 
            RowBox[{"referenceGamma1", "[", "]"}], "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<GammaHatKeys\>\"", "->", 
           RowBox[{"Length", "[", 
            RowBox[{"gammaHatS11", "[", "d", "]"}], "]"}]}]}], "|>"}]}]}], 
      "\n", " ", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allS11", "[", 
      RowBox[{"corr_List", ",", "p_List"}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Dataset", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"oneS11", "[", 
         RowBox[{"d", ",", "corr", ",", "p"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "5", ",", "9"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"compareAllDepths", "[", 
      RowBox[{"hh_Integer", ",", "corr_List", ",", "p_List"}], "]"}], " ", ":=",
      "\n", " ", 
     RowBox[{"Dataset", "[", 
      RowBox[{"Join", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"<|", 
             RowBox[{"\"\<Equation\>\"", "->", "\"\<S36\>\""}], "|>"}], ",", 
            "\n", "    ", 
            RowBox[{"oneS36", "[", 
             RowBox[{"d", ",", "hh", ",", "corr", ",", "p"}], "]"}]}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", "\n", "  ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"oneS11", "[", 
           RowBox[{"d", ",", "corr", ",", "p"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "5", ",", "9"}], "}"}]}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allRepetitionsBoth", "[", 
      RowBox[{"folderList_List", ",", 
       RowBox[{"hh_Integer:", "1"}]}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"records", "=", 
          RowBox[{"{", "}"}]}], ",", "raw", ",", "corr", ",", "p"}], "}"}], 
       ",", "\n", " ", 
       RowBox[{
        RowBox[{"Do", "[", "\n", "  ", 
         RowBox[{
          RowBox[{
           RowBox[{"raw", "=", 
            RowBox[{"loadRep", "[", 
             RowBox[{"folderList", "[", 
              RowBox[{"[", "rep", "]"}], "]"}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "raw", "]"}], "===", "Failure"}], ",", 
             "\n", "    ", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"records", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Repeat\>\"", "->", "rep"}], ",", 
                  RowBox[{"\"\<Error\>\"", "->", "raw"}]}], "|>"}]}], "]"}], 
              ";", "\n", "    ", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
           RowBox[{"corr", "=", 
            RowBox[{"correlators", "[", "raw", "]"}]}], ";", 
           RowBox[{"p", "=", 
            RowBox[{"computationalProbabilities", "[", "raw", "]"}]}], ";", 
           "\n", "  ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Head", "[", "corr", "]"}], "===", "Failure"}], "||", 
              RowBox[{
               RowBox[{"Head", "[", "p", "]"}], "===", "Failure"}]}], ",", 
             "\n", "    ", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"records", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Repeat\>\"", "->", "rep"}], ",", "\n", 
                  "      ", 
                  RowBox[{
                  "\"\<Error\>\"", "->", "\"\<Bad experiment file\>\""}]}], 
                 "|>"}]}], "]"}], ";", "\n", "    ", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
           RowBox[{"records", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"records", ",", 
              RowBox[{"Table", "[", "\n", "     ", 
               RowBox[{
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<Repeat\>\"", "->", "rep"}], ",", 
                    RowBox[{"\"\<Equation\>\"", "->", "\"\<S36\>\""}]}], 
                   "|>"}], ",", "\n", "       ", 
                  RowBox[{"oneS36", "[", 
                   RowBox[{"d", ",", "hh", ",", "corr", ",", "p"}], "]"}]}], 
                 "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"d", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", "\n",
               "    ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"<|", 
                   RowBox[{"\"\<Repeat\>\"", "->", "rep"}], "|>"}], ",", "\n",
                   "       ", 
                  RowBox[{"oneS11", "[", 
                   RowBox[{"d", ",", "corr", ",", "p"}], "]"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"d", ",", "5", ",", "9"}], "}"}]}], "]"}]}], 
             "]"}]}]}], ",", "\n", "  ", 
          RowBox[{"{", 
           RowBox[{"rep", ",", 
            RowBox[{"Length", "[", "folderList", "]"}]}], "}"}]}], "]"}], ";",
         "\n", " ", 
        RowBox[{"Dataset", "[", "records", "]"}]}]}], "]"}]}], ";"}], 
   "\n"}]}]], "Input",ExpressionUUID->"1d6f9615-8f86-4eb6-bcd4-03fcff114101"]
