Cell["2. Read 341 measured settings for each of 10 repetitions", "Section",ExpressionUUID->"71cd0b7b-53cf-4230-a2d1-869826698de2"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"IMPORTANT", ":", " ", 
     RowBox[{
     "replace", " ", "folders", " ", "with", " ", "the", " ", "ten", " ", 
      "ACTUAL", " ", "separate", " ", 
      RowBox[{"folders", ".", "\n", "   ", "Originally"}], " ", "all", " ", 
      "ten", " ", "paths", " ", "were", " ", "rep0"}]}], ",", " ", 
    RowBox[{"which", " ", "would", " ", "duplicate", " ", 
     RowBox[{"data", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
    "baseDir", "=", 
     "\"\<E:\\\\Detection of k partite \
entanglement\\\\Experimental_special_bases\\\\9qcluster_special_bases\\\\\
special_bases\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"folders", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"baseDir", ",", 
          RowBox[{"\"\<rep\>\"", "<>", 
           RowBox[{"ToString", "[", "k", "]"}]}], ",", "\n", " ", 
          "\"\<9Q_Cluster_1500ns\>\"", ",", "\"\<readout_cali\>\""}], "}"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "9"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Edit", " ", 
     RowBox[{"folders", "[", 
      RowBox[{"[", "k", "]"}], "]"}], " ", "if", " ", "the", " ", "actual", 
     " ", "repetition", " ", "folder", " ", 
     RowBox[{"differs", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"loadRep", ",", "probabilities", ",", "correlators"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"loadRep", "[", "folder_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"files", ",", "missing"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"files", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"folder", ",", 
              RowBox[{"\"\<basis_measurement\>\"", "<>", 
               RowBox[{"ToString", "[", "t", "]"}], "<>", "\"\<.txt\>\""}]}], 
             "}"}], "]"}], ",", "\n", "   ", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "340"}], "}"}]}], "]"}]}], ";", "\n", 
        " ", 
        RowBox[{"missing", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"files", ",", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"FileExistsQ", "[", "#", "]"}]}], "&"}]}], "]"}]}], ";", 
        "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"missing", "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<MissingFiles\>\"", ",", "\n", "  ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Folder\>\"", "->", "folder"}], ",", 
               RowBox[{"\"\<MissingCount\>\"", "->", 
                RowBox[{"Length", "[", "missing", "]"}]}], ",", "\n", "    ", 
               RowBox[{"\"\<FirstMissing\>\"", "->", 
                RowBox[{"First", "[", "missing", "]"}]}]}], "|>"}]}], "]"}], 
           "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Import", "[", 
           RowBox[{"#", ",", "\"\<Table\>\""}], "]"}], "&"}], "/@", 
         "files"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Qubit", " ", "1", " ", "is", " ", "LSB", " ", "of", " ", "the", " ", 
       "outcome", " ", "number", " ", "x"}], "-", "1"}], ",", " ", 
     RowBox[{"as", " ", "in", " ", 
      RowBox[{"user", "'"}], "s", " ", "nested", " ", 
      RowBox[{"loops", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"paritySigns", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"DigitCount", "[", 
         RowBox[{"x", ",", "2", ",", "1"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "511"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"probabilities", "[", "measure_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "v", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "measure", "]"}], "!=", "512"}], "||", 
           RowBox[{"!", 
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "#", "]"}], ">=", "1"}], "&"}], "/@", 
               "measure"}], ")"}]}]}]}], ",", "\n", "  ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<WrongOutcomeCount\>\"", ",", 
             RowBox[{"<|", "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"v", "=", 
         RowBox[{"N", "[", 
          RowBox[{"measure", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"VectorQ", "[", 
             RowBox[{"v", ",", "NumericQ"}], "]"}]}], "||", 
           RowBox[{
            RowBox[{"Min", "[", "v", "]"}], "<", "0"}], "||", 
           RowBox[{
            RowBox[{"Total", "[", "v", "]"}], "<=", "0"}]}], ",", "\n", "  ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<BadProbabilities\>\"", ",", 
             RowBox[{"<|", "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"v", "/", 
         RowBox[{"Total", "[", "v", "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"correlators", "[", "block_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "p", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "block", "]"}], "!=", "341"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<WrongSettingCount\>\"", ",", 
             RowBox[{"<|", "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "=", 
            RowBox[{"probabilities", "[", 
             RowBox[{"block", "[", 
              RowBox[{"[", "r", "]"}], "]"}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "p", "]"}], "===", "Failure"}], ",", 
             RowBox[{"Return", "[", "p", "]"}]}], "]"}], ";", "\n", "  ", 
           RowBox[{"paritySigns", ".", "p"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "1", ",", "341"}], "}"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Row", " ", "340", " ", "corresponds", " ", "to", " ", 
     RowBox[{"basis_measurement339", ".", "txt"}], " ", "and", " ", 
     RowBox[{"Z", "^", "9."}], "\n", "   ", "This", " ", "distribution", " ", 
     "is", " ", "indexed", " ", "Q1", " ", "as", " ", "the", " ", "least", 
     " ", "significant", " ", 
     RowBox[{"bit", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"computationalProbabilities", "[", "block_List", "]"}], ":=", 
     RowBox[{"probabilities", "[", 
      RowBox[{"block", "[", 
       RowBox[{"[", "340", "]"}], "]"}], "]"}]}], ";"}], "\n"}]}]], "Input",
 CellLabel->
  "In[639]:=",ExpressionUUID->"95bb430d-d106-4283-a6b3-a3988b701c54"]
