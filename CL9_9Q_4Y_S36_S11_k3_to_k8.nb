Cell[CellGroupData[{

Cell["\<\
4. Construct Gamma state-number pairs and Upsilon joint-number pairs \
(Notation S3\[AHat]\.80\.93S6)\
\>", "Section",ExpressionUUID->"d4be2f17-1282-41d2-b4e1-18ce58b7649d"],

Cell["\<\
For each chosen union B of 1..h blocks: swapping B produces a and b. Gamma \
contains (a,1/2),(b,1/2), and Upsilon contains ((a,b),1). For a fixed \
partition, all selected B and all Omega pairs are added. Different partitions \
are merged by coefficientwise maximum. Crucially, Gamma contributes sum of \
POPULATIONS p_a; Upsilon contributes sum of sqrt(p_a p_b). These must not be \
interchanged.\
\>", "Text",ExpressionUUID->"dc5cee14-8d03-4005-b2a5-af97622d8a6e"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "boundedPartitions", ",", "minPartitions", ",", "subsetChoices", ",", 
      "partialSwap", ",", "\n", " ", "stateKey", ",", "jointKey", ",", 
      "decodeState", ",", "decodeJoint", ",", "\n", " ", 
      "gammaUpsilonForPartition", ",", "associationAdd", ",", 
      "associationMax", ",", "\n", " ", "gammaD", ",", "upsilonD", ",", 
      "refUpsilon", ",", "hatUpsilon", ",", "\n", " ", "cDh", ",", "epsGamma",
       ",", "epsUpsilon"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"boundedPartitions", "[", 
      RowBox[{"0", ",", 
       RowBox[{"d_Integer", "?", "Positive"}]}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{"{", "}"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"boundedPartitions", "[", 
      RowBox[{
       RowBox[{"nn_Integer", "?", "Positive"}], ",", 
       RowBox[{"d_Integer", "?", "Positive"}]}], "]"}], ":=", "\n", " ", 
     RowBox[{
      RowBox[{"boundedPartitions", "[", 
       RowBox[{"nn", ",", "d"}], "]"}], "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"prev", "=", 
          RowBox[{"boundedPartitions", "[", 
           RowBox[{
            RowBox[{"nn", "-", "1"}], ",", "d"}], "]"}]}], "}"}], ",", "\n", 
        " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Append", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", "nn", "}"}]}], "]"}], "&"}], "/@", "prev"}], 
           ")"}], ",", "\n", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"q", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "]"}], "<", "d"}], ",", 
                "\n", "   ", 
                RowBox[{"{", 
                 RowBox[{"ReplacePart", "[", 
                  RowBox[{"q", ",", 
                   RowBox[{"k", "->", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"q", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", "nn"}], "]"}]}]}], 
                  "]"}], "}"}], ",", 
                RowBox[{"{", "}"}]}], "]"}], ",", "\n", "   ", 
              RowBox[{"{", 
               RowBox[{"q", ",", "prev"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"Length", "[", "q", "]"}]}], "}"}]}], "]"}], ",", 
            "2"}], "]"}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"D", "*", 
     RowBox[{"_d", ":", " ", 
      RowBox[{
      "partitions", " ", "with", " ", "the", " ", "minimal", " ", "number", 
       " ", "of", " ", 
       RowBox[{"blocks", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"minPartitions", "[", 
      RowBox[{"d_Integer", "?", "Positive"}], "]"}], ":=", "\n", " ", 
     RowBox[{
      RowBox[{"minPartitions", "[", "d", "]"}], "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"boundedPartitions", "[", 
         RowBox[{"9", ",", "d"}], "]"}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "==", 
          RowBox[{"Ceiling", "[", 
           RowBox[{"9", "/", "d"}], "]"}]}], "&"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"I_gamma", "^", 
      RowBox[{"h", ":", " ", 
       RowBox[{"choose", " ", "u", " ", "blocks"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"for", " ", "1"}], "<=", "u", "<=", "h"}], ";", " ", 
      RowBox[{"each", " ", "subset", " ", "is", " ", "ONE", " ", 
       RowBox[{"B", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"subsetChoices", "[", 
      RowBox[{"part_List", ",", 
       RowBox[{"hh_Integer", "?", "Positive"}]}], "]"}], ":=", "\n", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Flatten", "/@", 
          RowBox[{"Subsets", "[", 
           RowBox[{"part", ",", 
            RowBox[{"{", "u", "}"}]}], "]"}]}], ",", "\n", "   ", 
         RowBox[{"{", 
          RowBox[{"u", ",", "1", ",", 
           RowBox[{"Min", "[", 
            RowBox[{"hh", ",", 
             RowBox[{"Length", "[", "part", "]"}]}], "]"}]}], "}"}]}], "]"}], 
       ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"partialSwap", "[", 
      RowBox[{"pair_List", ",", "sites_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"pair", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"b", "=", 
          RowBox[{"pair", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "temp"}], "}"}], ",", "\n", 
       " ", 
       RowBox[{
        RowBox[{"temp", "=", 
         RowBox[{"a", "[", 
          RowBox[{"[", "sites", "]"}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", "sites", "]"}], "]"}], "=", 
         RowBox[{"b", "[", 
          RowBox[{"[", "sites", "]"}], "]"}]}], ";", "\n", " ", 
        RowBox[{
         RowBox[{"b", "[", 
          RowBox[{"[", "sites", "]"}], "]"}], "=", "temp"}], ";", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"stateKey", "[", "s_List", "]"}], ":=", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"ToString", "/@", "s"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"jointKey", "[", "ab_List", "]"}], ":=", 
     RowBox[{"StringRiffle", "[", 
      RowBox[{
       RowBox[{"stateKey", "/@", 
        RowBox[{"Sort", "[", "ab", "]"}]}], ",", "\"\<|\>\""}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"decodeState", "[", "k_String", "]"}], ":=", 
     RowBox[{"toBits", "[", "k", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"decodeJoint", "[", "k_String", "]"}], ":=", 
     RowBox[{"toBits", "/@", 
      RowBox[{"StringSplit", "[", 
       RowBox[{"k", ",", "\"\<|\>\""}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"associationAdd", "[", "arr_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"keys", "=", 
         RowBox[{"Union", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Keys", "/@", "arr"}], "]"}], "]"}]}], "}"}], ",", "\n", 
       " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"keys", ",", "\n", "  ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"arr", ",", "key", ",", "0"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"key", ",", "keys"}], "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"associationMax", "[", "arr_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"keys", "=", 
         RowBox[{"Union", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Keys", "/@", "arr"}], "]"}], "]"}]}], "}"}], ",", "\n", 
       " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"keys", ",", "\n", "  ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"arr", ",", "key", ",", "0"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"key", ",", "keys"}], "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gammaUpsilonForPartition", "[", 
      RowBox[{"part_List", ",", 
       RowBox[{"hh_Integer", "?", "Positive"}]}], "]"}], ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"choices", "=", 
          RowBox[{"subsetChoices", "[", 
           RowBox[{"part", ",", "hh"}], "]"}]}], ",", "pairs", ",", 
         "gEntries", ",", "uEntries"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"pairs", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"partialSwap", "[", 
              RowBox[{"ab", ",", "b"}], "]"}], ",", "\n", "     ", 
             RowBox[{"{", 
              RowBox[{"ab", ",", "omega"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"b", ",", "choices"}], "}"}]}], "]"}], ",", "1"}], 
          "]"}]}], ";", "\n", " ", 
        RowBox[{"gEntries", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"stateKey", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
                 RowBox[{"1", "/", "2"}]}], ",", "\n", "                   ", 
                RowBox[{
                 RowBox[{"stateKey", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}], "->", 
                 RowBox[{"1", "/", "2"}]}]}], "}"}], "&"}], "/@", "pairs"}], 
            ")"}], ",", "1"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"uEntries", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"jointKey", "[", "#", "]"}], "->", "1"}], "&"}], "/@", 
           "pairs"}], ")"}]}], ";", "\n", " ", 
        RowBox[{"{", "\n", "  ", 
         RowBox[{
          RowBox[{"Merge", "[", 
           RowBox[{"gEntries", ",", "Total"}], "]"}], ",", "\n", "  ", 
          RowBox[{"Merge", "[", 
           RowBox[{"uEntries", ",", "Total"}], "]"}]}], "\n", " ", "}"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gammaD", "[", 
      RowBox[{
       RowBox[{"d_Integer", "?", "Positive"}], ",", 
       RowBox[{"hh_Integer", "?", "Positive"}]}], "]"}], ":=", "\n", " ", 
     RowBox[{
      RowBox[{"gammaD", "[", 
       RowBox[{"d", ",", "hh"}], "]"}], "=", 
      RowBox[{"associationMax", "[", "\n", "  ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"gammaUpsilonForPartition", "[", 
            RowBox[{"#", ",", "hh"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", 
         RowBox[{"minPartitions", "[", "d", "]"}]}], ")"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"upsilonD", "[", 
      RowBox[{
       RowBox[{"d_Integer", "?", "Positive"}], ",", 
       RowBox[{"hh_Integer", "?", "Positive"}]}], "]"}], ":=", "\n", " ", 
     RowBox[{
      RowBox[{"upsilonD", "[", 
       RowBox[{"d", ",", "hh"}], "]"}], "=", 
      RowBox[{"associationMax", "[", "\n", "  ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"gammaUpsilonForPartition", "[", 
            RowBox[{"#", ",", "hh"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", 
         RowBox[{"minPartitions", "[", "d", "]"}]}], ")"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"reference", " ", "Upsilon", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1", "D"}], ",", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"N", "/", "2"}], "]"}]}], ")"}]}], ":", " ", 
      RowBox[{"singleton", " ", "blocks"}]}], ",", " ", 
     RowBox[{"up", " ", "to", " ", "four", " ", "chosen"}]}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"refUpsilon", "[", "]"}], ":=", 
     RowBox[{
      RowBox[{"refUpsilon", "[", "]"}], "=", 
      RowBox[{
       RowBox[{"gammaUpsilonForPartition", "[", "\n", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", "#", "}"}], "&"}], "/@", 
           RowBox[{"Range", "[", "9", "]"}]}], ")"}], ",", 
         RowBox[{"Floor", "[", 
          RowBox[{"9", "/", "2"}], "]"}]}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Set", " ", 
      RowBox[{"difference", ":", " ", 
       RowBox[{
       "fully", " ", "remove", " ", "shared", " ", "pair", " ", "keys"}]}]}], 
     ";", " ", 
     RowBox[{"do", " ", "not", " ", "subtract", " ", "weights"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"hatUpsilon", "[", 
      RowBox[{
       RowBox[{"d_Integer", "?", "Positive"}], ",", 
       RowBox[{"hh_Integer", "?", "Positive"}]}], "]"}], ":=", "\n", " ", 
     RowBox[{
      RowBox[{"hatUpsilon", "[", 
       RowBox[{"d", ",", "hh"}], "]"}], "=", 
      RowBox[{"KeySelect", "[", 
       RowBox[{
        RowBox[{"refUpsilon", "[", "]"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{
            RowBox[{"upsilonD", "[", 
             RowBox[{"d", ",", "hh"}], "]"}], ",", "#"}], "]"}]}], "&"}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cDh", "[", 
      RowBox[{
       RowBox[{"d_Integer", "?", "Positive"}], ",", 
       RowBox[{"hh_Integer", "?", "Positive"}]}], "]"}], ":=", "\n", " ", 
     RowBox[{
      RowBox[{"cDh", "[", 
       RowBox[{"d", ",", "hh"}], "]"}], "=", 
      RowBox[{"Min", "[", "\n", "  ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], ",", "u"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"u", ",", "1", ",", 
              RowBox[{"Min", "[", 
               RowBox[{"hh", ",", 
                RowBox[{"Length", "[", "#", "]"}]}], "]"}]}], "}"}]}], "]"}], 
          "&"}], "\n", "    ", "/@", 
         RowBox[{"minPartitions", "[", "d", "]"}]}], ")"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"epsGamma", "[", 
      RowBox[{"c_Association", ",", "p_List"}], "]"}], ":=", 
     RowBox[{"Total", "[", 
      RowBox[{"KeyValueMap", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"k", ",", "x"}], "}"}], ",", 
          RowBox[{"x", " ", 
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{"binIndex", "[", 
              RowBox[{"decodeState", "[", "k", "]"}], "]"}], "]"}], "]"}]}]}],
          "]"}], ",", "c"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"epsUpsilon", "[", 
      RowBox[{"c_Association", ",", "p_List"}], "]"}], ":=", 
     RowBox[{"Total", "[", 
      RowBox[{"KeyValueMap", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"k", ",", "x"}], "}"}], ",", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ab", "=", 
              RowBox[{"decodeJoint", "[", "k", "]"}]}], "}"}], ",", "\n", 
            "    ", 
            RowBox[{"x", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{"p", "[", 
                RowBox[{"[", 
                 RowBox[{"binIndex", "[", 
                  RowBox[{"ab", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "*", 
               RowBox[{"p", "[", 
                RowBox[{"[", 
                 RowBox[{"binIndex", "[", 
                  RowBox[{"ab", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
              "]"}]}]}], "]"}]}], "]"}], ",", "c"}], "]"}], "]"}]}], ";"}], 
   "\n"}]}]], "Input",
 CellLabel->
  "In[660]:=",ExpressionUUID->"ab035327-ab79-43f7-895f-8f01281cce36"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. S36 LEFT and RIGHT for j=4, depths d=1..4", "Section",ExpressionUUID->"1c0ebf21-4507-43b8-b435-7d1d342be1a7"],

Cell["\<\
For 4Y: f4(9)=14 and binomial(9,4)=126. LEFT=C_d^h [Sum_Omega |W4(m)|-28 \
Sum_Omega sqrt(p_m p_n)]/[252+28(C_d^h-1)]. RIGHT=epsUpsilon(Upsilon_dD)+[14 \
C_d^h/(126+14(C_d^h-1))] epsUpsilon(hatUpsilon_dD). Compare Delta=LEFT-RIGHT. \
Positive Delta violates the corresponding d-producibility bound.\
\>", "Text",ExpressionUUID->"170bd431-628b-46ff-85bb-bfab61746b00"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"oneS36", ",", "allS36"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"oneS36", "[", 
      RowBox[{
      "d_Integer", ",", "hh_Integer", ",", "corr_List", ",", "p_List"}], 
      "]"}], ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "wv", ",", "f", ",", "C", ",", "den", ",", "left", ",", "right", ",", 
         "e", ",", "eh", ",", "pairPop"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"1", "<=", "d", "<=", "4"}], " ", "&&", " ", 
             RowBox[{"hh", ">=", "1"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Length", "[", "corr", "]"}], ">=", "340"}], " ", "&&", 
             "\n", "   ", 
             RowBox[{
              RowBox[{"Length", "[", "p", "]"}], "==", "512"}], " ", "&&", 
             " ", 
             RowBox[{"VectorQ", "[", 
              RowBox[{"corr", ",", "NumericQ"}], "]"}], "&&", 
             RowBox[{"VectorQ", "[", 
              RowBox[{"p", ",", "NumericQ"}], "]"}]}], ")"}]}], ",", "\n", 
          "   ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<BadInput\>\"", ",", 
             RowBox[{"<|", "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"wv", "=", 
         RowBox[{"allW", "[", 
          RowBox[{"4", ",", "corr"}], "]"}]}], ";", 
        RowBox[{"f", "=", 
         RowBox[{"fPaper", "[", 
          RowBox[{"4", ",", "9"}], "]"}]}], ";", 
        RowBox[{"C", "=", 
         RowBox[{"cDh", "[", 
          RowBox[{"d", ",", "hh"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"pairPop", "=", 
         RowBox[{"pairPopulation", "[", "p", "]"}]}], ";", 
        RowBox[{"den", "=", 
         RowBox[{
          RowBox[{"Binomial", "[", 
           RowBox[{"9", ",", "4"}], "]"}], "+", 
          RowBox[{"f", 
           RowBox[{"(", 
            RowBox[{"C", "-", "1"}], ")"}]}]}]}], ";", "\n", " ", 
        RowBox[{"left", "=", 
         RowBox[{"N", "[", 
          RowBox[{"C", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Abs", "[", "wv", "]"}], "]"}], "-", 
              RowBox[{"2", " ", "f", " ", "pairPop"}]}], ")"}], "/", 
            RowBox[{"(", " ", "den", ")"}]}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"e", "=", 
         RowBox[{"N", "[", 
          RowBox[{"epsUpsilon", "[", 
           RowBox[{
            RowBox[{"upsilonD", "[", 
             RowBox[{"d", ",", "hh"}], "]"}], ",", "p"}], "]"}], "]"}]}], ";",
         "\n", " ", 
        RowBox[{"eh", "=", 
         RowBox[{"N", "[", 
          RowBox[{"epsUpsilon", "[", 
           RowBox[{
            RowBox[{"hatUpsilon", "[", 
             RowBox[{"d", ",", "hh"}], "]"}], ",", "p"}], "]"}], "]"}]}], ";",
         "\n", " ", 
        RowBox[{"right", "=", 
         RowBox[{"N", "[", 
          RowBox[{"e", "+", 
           RowBox[{"f", "*", 
            RowBox[{"C", "/", "den"}], "*", "eh"}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<d\>\"", "->", "d"}], ",", 
          RowBox[{"\"\<h\>\"", "->", "hh"}], ",", "\n", "   ", 
          RowBox[{"\"\<W(1,8)\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"wv", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<W(2,7)\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"wv", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<W(3,6)\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"wv", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<W(4,5)\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"wv", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<SumAbsW\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"Total", "[", 
             RowBox[{"Abs", "[", "wv", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<Cdh\>\"", "->", "C"}], ",", "\n", "   ", 
          RowBox[{"\"\<PairPopulationSum\>\"", "->", 
           RowBox[{"N", "[", "pairPop", "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<EpsilonGamma\>\"", "->", "e"}], ",", 
          RowBox[{"\"\<EpsilonHat\>\"", "->", "eh"}], ",", "\n", "   ", 
          RowBox[{"\"\<LEFT\>\"", "->", "left"}], ",", 
          RowBox[{"\"\<RIGHT\>\"", "->", "right"}], ",", 
          RowBox[{"\"\<Delta\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"left", "-", "right"}], "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<ViolationQ\>\"", "->", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"left", ">", "right"}], "]"}]}]}], "|>"}]}]}], "\n", " ", 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allS36", "[", 
      RowBox[{"hh_Integer", ",", "corr_List", ",", "p_List"}], "]"}], ":=", 
     "\n", " ", 
     RowBox[{"Dataset", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"oneS36", "[", 
         RowBox[{"d", ",", "hh", ",", "corr", ",", "p"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "1", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{
  4.0011588776047373`*^9},ExpressionUUID->"11f475f5-2264-4678-9182-\
bbafe3b6723f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Run the 10-repetition experiment", "Section",ExpressionUUID->"0b79faa8-a5e4-460b-b51a-1ab777dc98d4"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "allRepetitions", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allRepetitions", "[", 
      RowBox[{"folderList_List", ",", 
       RowBox[{"hh_Integer:", "1"}]}], "]"}], ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"results", "=", 
          RowBox[{"{", "}"}]}], ",", "raw", ",", "corr", ",", "p", ",", 
         "ans"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"Do", "[", "\n", "  ", 
         RowBox[{
          RowBox[{
           RowBox[{"raw", "=", 
            RowBox[{"loadRep", "[", 
             RowBox[{"folderList", "[", 
              RowBox[{"[", "rep", "]"}], "]"}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "raw", "]"}], "===", "Failure"}], ",", 
             "\n", "   ", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"results", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Repeat\>\"", "->", "rep"}], ",", 
                  RowBox[{"\"\<Error\>\"", "->", "raw"}]}], "|>"}]}], "]"}], 
              ";", "\n", "   ", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
           RowBox[{"corr", "=", 
            RowBox[{"correlators", "[", "raw", "]"}]}], ";", 
           RowBox[{"p", "=", 
            RowBox[{"computationalProbabilities", "[", "raw", "]"}]}], ";", 
           "\n", "  ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Head", "[", "corr", "]"}], "===", "Failure"}], "||", 
              RowBox[{
               RowBox[{"Head", "[", "p", "]"}], "===", "Failure"}]}], ",", 
             "\n", "   ", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"results", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Repeat\>\"", "->", "rep"}], ",", "\n", "     ", 
                  RowBox[{
                  "\"\<Error\>\"", "->", 
                   "\"\<Invalid measurement file format\>\""}]}], "|>"}]}], 
               "]"}], ";", "\n", "   ", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
           RowBox[{"Do", "[", "\n", "   ", 
            RowBox[{
             RowBox[{
              RowBox[{"ans", "=", 
               RowBox[{"oneS36", "[", 
                RowBox[{"d", ",", "hh", ",", "corr", ",", "p"}], "]"}]}], ";",
               "\n", "   ", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"results", ",", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"<|", 
                   RowBox[{"\"\<Repeat\>\"", "->", "rep"}], "|>"}], ",", 
                  "ans"}], "]"}]}], "]"}]}], ",", "\n", "   ", 
             RowBox[{"{", 
              RowBox[{"d", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", "\n", 
          "  ", 
          RowBox[{"{", 
           RowBox[{"rep", ",", "1", ",", 
            RowBox[{"Length", "[", "folderList", "]"}]}], "}"}]}], "]"}], ";",
         "\n", " ", 
        RowBox[{"Dataset", "[", "results", "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Actual", " ", 
       RowBox[{"experiment", ":", "\n", "results4Y"}]}], "=", 
      RowBox[{"allRepetitions", "[", 
       RowBox[{"folders", ",", "1"}], "]"}]}], ";", "\n", "results4Y"}], "\n",
     "*)"}], "\n"}]}]], "Input",
 CellLabel->
  "In[683]:=",ExpressionUUID->"5daf48a0-d894-4ec3-8cae-451e4583c00c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Worked example with ideal pure CL9 (no external files)", "Section",ExpressionUUID->"f6ad90da-6b00-46bf-b28f-874c9f256630"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"idealKet", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "512"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"idealKet", "[", 
        RowBox[{"[", 
         RowBox[{"binIndex", "[", 
          RowBox[{"toBits", "[", "s", "]"}], "]"}], "]"}], "]"}], "=", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "stateStrings"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"idealP", "=", 
     RowBox[{
      RowBox[{"Abs", "[", "idealKet", "]"}], "^", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"idealPauli", "[", "code_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"flipSites", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"code", ",", 
             RowBox[{"1", "|", "2"}]}], "]"}], "]"}]}], ",", "\n", " ", 
         RowBox[{"yzSites", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"code", ",", 
             RowBox[{"2", "|", "3"}]}], "]"}], "]"}]}], ",", 
         RowBox[{"yy", "=", 
          RowBox[{"Count", "[", 
           RowBox[{"code", ",", "2"}], "]"}]}]}], "}"}], ",", "\n", " ", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"b", "=", 
               RowBox[{"IntegerDigits", "[", 
                RowBox[{"x", ",", "2", ",", "9"}], "]"}]}], ",", "nb", ",", 
              "phase"}], "}"}], ",", "\n", "  ", 
            RowBox[{
             RowBox[{"nb", "=", "b"}], ";", 
             RowBox[{
              RowBox[{"nb", "[", 
               RowBox[{"[", "flipSites", "]"}], "]"}], "=", 
              RowBox[{"1", "-", 
               RowBox[{"nb", "[", 
                RowBox[{"[", "flipSites", "]"}], "]"}]}]}], ";", "\n", "  ", 
             RowBox[{"phase", "=", 
              RowBox[{
               RowBox[{"I", "^", "yy"}], " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", 
                RowBox[{"Total", "[", 
                 RowBox[{"b", "[", 
                  RowBox[{"[", "yzSites", "]"}], "]"}], "]"}]}]}]}], ";", 
             "\n", "  ", 
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"idealKet", "[", 
                RowBox[{"[", 
                 RowBox[{"binIndex", "[", "nb", "]"}], "]"}], "]"}], "]"}], 
              "*", "phase", "*", "\n", "      ", 
              RowBox[{"idealKet", "[", 
               RowBox[{"[", 
                RowBox[{"binIndex", "[", "b", "]"}], "]"}], "]"}]}]}]}], 
           "]"}], ",", "\n", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "511"}], "}"}]}], "]"}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"idealCorr", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "341"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"idealCorr", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"rowsByY", "[", "4", "]"}], "[", 
          RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], "=", 
       RowBox[{"idealPauli", "[", 
        RowBox[{
