Cell[CellGroupData[{

Cell["\<\
9. Worked ideal-state and experimental examples covering d=1..9\
\>", "Section",ExpressionUUID->"821585f9-3682-4973-b488-cc6c155afff4"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Run", " ", "Section", " ", "7", " ", "once", " ", "to", " ", "define", 
    " ", "idealCorr", " ", "and", " ", 
    RowBox[{"idealP", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<S11 high-depth comparison (ideal CL9):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"allS11", "[", 
    RowBox[{"idealCorr", ",", "idealP"}], "]"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<S36 + S11 comparison (ideal CL9):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"compareAllDepths", "[", 
    RowBox[{"1", ",", "idealCorr", ",", "idealP"}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "To", " ", "read", " ", "10", " ", "independent", " ", "real", " ", 
       "experimental", " ", 
       RowBox[{"repetitions", ":", "\n", "  ", "resultsBoth"}]}], "=", 
      RowBox[{"allRepetitionsBoth", "[", 
       RowBox[{"folders", ",", "1"}], "]"}]}], ";", "\n", "  ", 
     "resultsBoth"}], "\n", "*)"}], "\n"}]}]], "Input",ExpressionUUID->\
"5f5d522e-652d-48d8-9354-2aa72b5e8858"],

Cell["\<\
Important: the right side of S11 uses state-number-pair Gamma weights, not \
S36's joint-number-pair Upsilon weights. Confirm d=N interpretation and Gamma \
weighted state-difference convention with the full paper before publication. \
This notebook was not executed in a Wolfram Mathematica kernel; local \
experiment files are necessary to obtain experimental numerical results.\
\>", "Text",ExpressionUUID->"9551cb8b-4757-4d2b-8a40-8910921583ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. k-separability, k=3..8 (paper S36 substitution)", "Section",ExpressionUUID->"1436e37d-4217-42c6-b390-fa9ca4e740fa"],

Cell["\<\
For k-separability replace D*_d by S*_k in the Upsilon construction, and the \
reference Upsilon_(1D)^(Omega,Floor[N/2]) by Upsilon_(1S)^(Omega,Floor[N/2]). \
Both epsilon terms use JOINT-state-pair Upsilon, not Gamma. Coefficients add \
within each partition and are maximized over partitions. S*_k here enumerates \
all partitions into exactly k nonempty blocks. k=3..8 and h=1 or h=2 are \
supported.\
\>", "Text",ExpressionUUID->"61a017df-8e43-4c9a-bd3d-51030f097ee2"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "kPartitions9", ",", "kUpsilon9", ",", "kReference9", ",", "kHat9", ",", 
      "kC9", ",", "\n", "  ", "oneKS9", ",", "allKS9", ",", 
      "allRepeatedKS9"}], "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Exactly", " ", "k", " ", "blocks"}], ",", " ", 
     RowBox[{"unconstrained", " ", "block", " ", 
      RowBox[{"sizes", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"kPartitions9", "[", 
       RowBox[{"k_Integer", "?", "Positive"}], "]"}], " ", "/;", " ", 
      RowBox[{"1", "<=", "k", "<=", "9"}]}], " ", ":=", "\n", " ", 
     RowBox[{
      RowBox[{"kPartitions9", "[", "k", "]"}], " ", "=", "\n", "   ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"boundedPartitions", "[", 
         RowBox[{"9", ",", "9"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], "==", "k"}], "&"}]}], "]"}]}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Each", " ", "partition", " ", "uses", " ", "the", " ", "previously", 
      " ", "defined", " ", 
      RowBox[{"Gamma", "/", "Upsilon"}], " ", 
      RowBox[{"generator", ".", "\n", "   ", "Only"}], " ", "joint"}], "-", 
     RowBox[{"pair", " ", "Upsilon", " ", 
      RowBox[{"component", " ", "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", "is", " ", 
      RowBox[{"used", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kUpsilon9", "[", 
      RowBox[{"k_Integer", ",", "hh_Integer"}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{
      RowBox[{"kUpsilon9", "[", 
       RowBox[{"k", ",", "hh"}], "]"}], " ", "=", "\n", " ", 
      RowBox[{"associationMax", "[", "\n", "   ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"gammaUpsilonForPartition", "[", 
            RowBox[{"#", ",", "hh"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         RowBox[{"kPartitions9", "[", "k", "]"}]}], ")"}], "]"}]}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Special", " ", "reference", " ", "1"}], "-", 
      RowBox[{"separable", " ", 
       RowBox[{"construction", ":", " ", 
        RowBox[{"nine", " ", "singleton", " ", "blocks"}]}]}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"allow", " ", "up", " ", "to", " ", 
       RowBox[{"Floor", "[", 
        RowBox[{"9", "/", "2"}], "]"}]}], "=", 
      RowBox[{"4", " ", "swapped", " ", 
       RowBox[{"blocks", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kReference9", "[", "]"}], " ", ":=", "\n", " ", 
     RowBox[{
      RowBox[{"kReference9", "[", "]"}], " ", "=", "\n", " ", 
      RowBox[{
       RowBox[{"gammaUpsilonForPartition", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", "#", "}"}], "&"}], "/@", 
           RowBox[{"Range", "[", "9", "]"}]}], ")"}], ",", 
         RowBox[{"Floor", "[", 
          RowBox[{"9", "/", "2"}], "]"}]}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Set", " ", 
      RowBox[{"difference", ":", " ", 
       RowBox[{
       "delete", " ", "ALL", " ", "shared", " ", "pair", " ", "keys"}]}]}], 
     ",", " ", 
     RowBox[{"never", " ", "subtract", " ", 
      RowBox[{"weights", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kHat9", "[", 
      RowBox[{"k_Integer", ",", "hh_Integer"}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{
      RowBox[{"kHat9", "[", 
       RowBox[{"k", ",", "hh"}], "]"}], " ", "=", "\n", " ", 
      RowBox[{"KeySelect", "[", 
       RowBox[{
        RowBox[{"kReference9", "[", "]"}], ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{
            RowBox[{"kUpsilon9", "[", 
             RowBox[{"k", ",", "hh"}], "]"}], ",", "#"}], "]"}]}], "&"}]}], 
       "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kC9", "[", 
      RowBox[{"k_Integer", ",", "hh_Integer"}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"Binomial", "[", 
        RowBox[{"k", ",", "u"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "1", ",", 
         RowBox[{"Min", "[", 
          RowBox[{"k", ",", "hh"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"oneKS9", "[", 
      RowBox[{
      "k_Integer", ",", "hh_Integer", ",", "corr_List", ",", "p_List"}], 
      "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wv", ",", "C", ",", 
         RowBox[{"f", "=", "14"}], ",", "den", ",", "left", ",", "right", ",",
          "e", ",", "eHat", ",", "pairPop"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"3", "<=", "k", "<=", "8"}], "&&", 
             RowBox[{"hh", ">=", "1"}], "&&", 
             RowBox[{
              RowBox[{"Length", "[", "corr", "]"}], ">=", "340"}], "&&", "\n",
              "        ", 
             RowBox[{
              RowBox[{"Length", "[", "p", "]"}], "==", "512"}], "&&", 
             RowBox[{"VectorQ", "[", 
              RowBox[{"corr", ",", "NumericQ"}], "]"}], "&&", "\n", 
             "        ", 
             RowBox[{"VectorQ", "[", 
              RowBox[{"p", ",", "NumericQ"}], "]"}], "&&", 
             RowBox[{
              RowBox[{"Min", "[", "p", "]"}], ">=", "0"}]}], ")"}]}], ",", 
          "\n", "   ", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<BadInput\>\"", ",", 
             RowBox[{"<|", "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"wv", "=", 
         RowBox[{"allW", "[", 
          RowBox[{"4", ",", "corr"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"C", "=", 
         RowBox[{"kC9", "[", 
          RowBox[{"k", ",", "hh"}], "]"}]}], ";", 
        RowBox[{"den", "=", 
         RowBox[{"126", "+", 
          RowBox[{"f", 
           RowBox[{"(", 
            RowBox[{"C", "-", "1"}], ")"}]}]}]}], ";", "\n", "  ", 
        RowBox[{"pairPop", "=", 
         RowBox[{"pairPopulation", "[", "p", "]"}]}], ";", "\n", "  ", 
        RowBox[{"left", "=", 
         RowBox[{"N", "[", 
          RowBox[{"C", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Abs", "[", "wv", "]"}], "]"}], "-", 
              RowBox[{"2", " ", "f", " ", "pairPop"}]}], ")"}], "/", 
            RowBox[{"(", "den", ")"}]}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"e", "=", 
         RowBox[{"N", "[", 
          RowBox[{"epsUpsilon", "[", 
           RowBox[{
            RowBox[{"kUpsilon9", "[", 
             RowBox[{"k", ",", "hh"}], "]"}], ",", "p"}], "]"}], "]"}]}], ";",
         "\n", "  ", 
        RowBox[{"eHat", "=", 
         RowBox[{"N", "[", 
          RowBox[{"epsUpsilon", "[", 
           RowBox[{
            RowBox[{"kHat9", "[", 
             RowBox[{"k", ",", "hh"}], "]"}], ",", "p"}], "]"}], "]"}]}], ";",
         "\n", "  ", 
        RowBox[{"right", "=", 
         RowBox[{"N", "[", 
          RowBox[{"e", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"f", " ", 
              RowBox[{"C", "/", "den"}]}], ")"}], "*", "eHat"}]}], "]"}]}], 
        ";", "\n", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<k\>\"", "->", "k"}], ",", 
          RowBox[{"\"\<h\>\"", "->", "hh"}], ",", 
          RowBox[{"\"\<C_k_h\>\"", "->", "C"}], ",", 
          RowBox[{"\"\<SumAbsW\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"Total", "[", 
             RowBox[{"Abs", "[", "wv", "]"}], "]"}], "]"}]}], ",", "\n", 
          "    ", 
          RowBox[{"\"\<Epsilon\>\"", "->", "e"}], ",", 
          RowBox[{"\"\<EpsilonHat\>\"", "->", "eHat"}], ",", "\n", "    ", 
          RowBox[{"\"\<LEFT\>\"", "->", "left"}], ",", 
          RowBox[{"\"\<RIGHT\>\"", "->", "right"}], ",", "\n", "    ", 
          RowBox[{"\"\<Delta\>\"", "->", 
           RowBox[{"left", "-", "right"}]}], ",", 
          RowBox[{"\"\<ViolationQ\>\"", "->", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"left", ">", "right"}], "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<PartitionCount\>\"", "->", 
           RowBox[{"Length", "[", 
            RowBox[{"kPartitions9", "[", "k", "]"}], "]"}]}]}], "|>"}]}]}], 
      "\n", " ", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allKS9", "[", 
      RowBox[{"hh_Integer", ",", "corr_List", ",", "p_List"}], "]"}], " ", ":=",
      "\n", " ", 
     RowBox[{"Dataset", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"oneKS9", "[", 
         RowBox[{"k", ",", "hh", ",", "corr", ",", "p"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3", ",", "8"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allRepeatedKS9", "[", 
      RowBox[{"folderList_List", ",", 
       RowBox[{"hh_Integer:", "1"}]}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rows", "=", 
          RowBox[{"{", "}"}]}], ",", "raw", ",", "corr", ",", "p"}], "}"}], 
       ",", "\n", "  ", 
       RowBox[{
        RowBox[{"Do", "[", "\n", "   ", 
         RowBox[{
          RowBox[{
           RowBox[{"raw", "=", 
            RowBox[{"loadRep", "[", 
             RowBox[{"folderList", "[", 
              RowBox[{"[", "rep", "]"}], "]"}], "]"}]}], ";", "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", "raw", "]"}], "===", "Failure"}], ",", 
             "\n", "    ", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"rows", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Repeat\>\"", "->", "rep"}], ",", 
                  RowBox[{"\"\<Error\>\"", "->", "raw"}]}], "|>"}]}], "]"}], 
              ";", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", "\n", "   ", 
           RowBox[{"corr", "=", 
            RowBox[{"correlators", "[", "raw", "]"}]}], ";", "\n", "   ", 
           RowBox[{"p", "=", 
            RowBox[{"computationalProbabilities", "[", "raw", "]"}]}], ";", 
           "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Head", "[", "corr", "]"}], "===", "Failure"}], "||", 
              RowBox[{
               RowBox[{"Head", "[", "p", "]"}], "===", "Failure"}]}], ",", 
             "\n", "    ", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"rows", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Repeat\>\"", "->", "rep"}], ",", "\n", 
                  "      ", 
                  RowBox[{
                  "\"\<Error\>\"", "->", "\"\<Invalid measured rows\>\""}]}], 
                 "|>"}]}], "]"}], ";", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", "\n", "   ", 
           RowBox[{"rows", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"rows", ",", 
              RowBox[{"Table", "[", "\n", "     ", 
               RowBox[{
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"<|", 
                   RowBox[{"\"\<Repeat\>\"", "->", "rep"}], "|>"}], ",", 
                  RowBox[{"oneKS9", "[", 
                   RowBox[{"k", ",", "hh", ",", "corr", ",", "p"}], "]"}]}], 
                 "]"}], ",", "\n", "     ", 
                RowBox[{"{", 
                 RowBox[{"k", ",", "3", ",", "8"}], "}"}]}], "]"}]}], 
             "]"}]}]}], ",", "\n", "   ", 
          RowBox[{"{", 
           RowBox[{"rep", ",", 
            RowBox[{"Length", "[", "folderList", "]"}]}], "}"}]}], "]"}], ";",
         "\n", " ", 
        RowBox[{"Dataset", "[", "rows", "]"}]}]}], "\n", " ", "]"}]}], ";"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{
  4.0011590081117077`*^9},ExpressionUUID->"579d8fbb-f3bb-4a88-a7bb-\
e5b4b8dc271b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Examples: k-separability and corrected S36", "Section",ExpressionUUID->"9054be2c-76e2-458f-a073-b9f78811911d"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "First", " ", "evaluate", " ", "the", " ", "earlier", " ", "notebook", " ",
     "cells", " ", "to", " ", "define", " ", "idealCorr", " ", "and", " ", 
    RowBox[{"idealP", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<k-separability (ideal CL9, h=1):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"allKS9", "[", 
    RowBox[{"1", ",", "idealCorr", ",", "idealP"}], "]"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<k-separability (ideal CL9, h=2):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"allKS9", "[", 
    RowBox[{"2", ",", "idealCorr", ",", "idealP"}], "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Experiment", ":", " ", 
      RowBox[{"supply", " ", "ten", " ", "real"}]}], ",", " ", 
     RowBox[{"DISTINCT", " ", "folders", " ", "before", " ", 
      RowBox[{"running", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"measuredKS_h1", "=", 
      RowBox[{"allRepeatedKS9", "[", 
       RowBox[{"folders", ",", "1"}], "]"}]}], ";"}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"measuredKS_h2", "=", 
      RowBox[{"allRepeatedKS9", "[", 
       RowBox[{"folders", ",", "2"}], "]"}]}], ";"}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", "measuredKS_h2", " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Show", " ", "the", " ", "corrected", " ", "S36", " ", "d"}], 
      "-", 
      RowBox[{"depth", " ", "rows"}]}], ",", " ", 
     RowBox[{
     "both", " ", "epsilon", " ", "terms", " ", "now", " ", "from", " ", 
      "Upsilon"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"allS36", "[", 
     RowBox[{"2", ",", "idealCorr", ",", "idealP"}], "]"}], " ", "*)"}], 
   "\n"}]}]], "Input",ExpressionUUID->"4f89b969-f564-49c6-be64-c63b021e9798"],

Cell["\<\
Accuracy caution: the Notation S3-S6 and S36 screenshot supports replacing \
D*_d and 1D reference by S*_k and 1S reference. Full paper-specific S*_k \
constraints and the half-subset convention (when h equals half the number of \
blocks) require checking against a verified author example; this code \
implements subset selection up to h without automatic halving. k=8,h=2 has \
many partitions but is finite. No experiment files are available here, so \
experimental LEFT/RIGHT numbers are not computed or claimed.\
\>", "Text",ExpressionUUID->"05ca214f-eaae-41c0-862e-caf229d0447a"]
}, Open  ]]
}, Open  ]]
},
