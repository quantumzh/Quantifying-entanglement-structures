Cell[CellGroupData[{

Cell["3. Signed W4^9 and the measured LEFT numerator", "Section",ExpressionUUID->"dcb2f887-6357-423a-a117-96d97a708393"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "signForCode", ",", "wFromCorrelations", ",", "allW", ",", "binIndex", 
      ",", "pairPopulation", ",", "fPaper"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"signForCode", "[", 
      RowBox[{"m_List", ",", "code_List"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", 
      RowBox[{"Total", "[", 
       RowBox[{"Pick", "[", 
        RowBox[{"m", ",", "code", ",", "2"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wFromCorrelations", "[", 
      RowBox[{"m_List", ",", "jj_Integer", ",", "observations_List"}], "]"}], 
     ":=", "\n", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"MapThread", "[", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"signForCode", "[", 
           RowBox[{"m", ",", "#2"}], "]"}], "*", 
          RowBox[{"observations", "[", 
           RowBox[{"[", "#1", "]"}], "]"}]}], "&"}], ",", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"rowsByY", "[", "jj", "]"}], ",", 
          RowBox[{"pauliCodes", "[", "jj", "]"}]}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"allW", "[", 
      RowBox[{"jj_Integer", ",", "observations_List"}], "]"}], ":=", "\n", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"wFromCorrelations", "[", 
        RowBox[{"#", ",", "jj", ",", "observations"}], "]"}], "&"}], "/@", 
      "ms"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"x", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "+", 
        RowBox[{"(", 
         RowBox[{"i1", "-", "1"}], ")"}], "+", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"i2", "-", "1"}], ")"}]}], "+"}], "..."}], "+", 
      RowBox[{"256", 
       RowBox[{"(", 
        RowBox[{"i9", "-", "1"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"binIndex", "[", "b_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"FromDigits", "[", 
       RowBox[{
        RowBox[{"Reverse", "[", "b", "]"}], ",", "2"}], "]"}], "+", "1"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pairPopulation", "[", "p_List", "]"}], ":=", 
     RowBox[{"Total", "[", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", 
            RowBox[{"binIndex", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "*", 
          RowBox[{"p", "[", 
           RowBox[{"[", 
            RowBox[{"binIndex", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}]}], "]"}], 
        "&"}], "/@", "omega"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fPaper", "[", 
      RowBox[{"2", ",", "3"}], "]"}], "=", "1"}], ";", 
    RowBox[{
     RowBox[{"fPaper", "[", 
      RowBox[{"2", ",", "4"}], "]"}], "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"fPaper", "[", 
       RowBox[{"2", ",", "k_Integer"}], "]"}], "/;", 
      RowBox[{"k", ">=", "5"}]}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"k", "-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "-", "4"}], ")"}], "/", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fPaper", "[", 
      RowBox[{"3", ",", "5"}], "]"}], "=", "2"}], ";", 
    RowBox[{
     RowBox[{"fPaper", "[", 
      RowBox[{"3", ",", "6"}], "]"}], "=", "4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"fPaper", "[", 
       RowBox[{"3", ",", "k_Integer"}], "]"}], "/;", 
      RowBox[{"k", ">=", "7"}]}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"fPaper", "[", 
        RowBox[{"2", ",", "u"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "6", ",", 
         RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fPaper", "[", 
      RowBox[{"4", ",", "5"}], "]"}], "=", "3"}], ";", 
    RowBox[{
     RowBox[{"fPaper", "[", 
      RowBox[{"4", ",", "6"}], "]"}], "=", "5"}], ";", 
    RowBox[{
     RowBox[{"fPaper", "[", 
      RowBox[{"4", ",", "7"}], "]"}], "=", "10"}], ";", 
    RowBox[{
     RowBox[{"fPaper", "[", 
      RowBox[{"4", ",", "8"}], "]"}], "=", "14"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"fPaper", "[", 
       RowBox[{"4", ",", "k_Integer"}], "]"}], "/;", 
      RowBox[{"k", ">=", "9"}]}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"fPaper", "[", 
        RowBox[{"3", ",", "u"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "8", ",", 
         RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<f4(9) = \>\"", ",", 
      RowBox[{"fPaper", "[", 
       RowBox[{"4", ",", "9"}], "]"}], ",", "\"\<; Binomial[9,4] = \>\"", ",", 
      RowBox[{"Binomial", "[", 
       RowBox[{"9", ",", "4"}], "]"}]}], "]"}], ";"}], "\n"}]}]], "Input",
